# ==============================================================================
# LoksewaAI - Django Backend Environment (apps/api)
# ==============================================================================
# Copy this file to apps/api/.env and fill in real values.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# apps/api/.env is git-ignored. NEVER commit real credentials.
# Real process environment variables always override values in this file, so
# production hosts can inject config without any .env file.
# ==============================================================================


# ------------------------------------------------------------------------------
# DATABASE - Supabase PostgreSQL
# ------------------------------------------------------------------------------
# Architecture:  Next.js -> Django REST API -> Supabase PostgreSQL
# The Django ORM is the only database abstraction layer. Next.js never receives
# these values and never connects to PostgreSQL directly.
#
# DATABASE_URL  Supabase "Transaction pooler" connection (port 6543).
#               Used by the running API process. Get it from:
#               Supabase Dashboard -> Project Settings -> Database ->
#               Connection string -> Transaction pooler (URI).
#
# DIRECT_URL    Supabase "Session pooler"/direct connection (port 5432).
#               Django uses this AUTOMATICALLY for schema commands
#               (migrate, makemigrations, test, dbshell, ...), because
#               PgBouncer transaction pooling cannot run them reliably.
#
# If DATABASE_URL is left empty, Django falls back to the local SQLite file
# apps/api/db.sqlite3. That fallback is DEVELOPMENT ONLY - production must set
# DATABASE_URL. Run `python manage.py dbcheck` to confirm which one is active.
#
# TLS is enforced in code (sslmode=require); do not add certificates here.
# The password must be URL-encoded if it contains @ : / ? # [ ] or %.
DATABASE_URL=
DIRECT_URL=

# Force the DIRECT_URL connection for every command (default: schema commands only)
# DJANGO_DB_USE_DIRECT=0


# ------------------------------------------------------------------------------
# DJANGO CORE
# ------------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Must be False in production. Startup fails if DEBUG=False and no secret key.
DJANGO_DEBUG=True

# Space-separated. Example: "api.loksewaai.com www.loksewaai.com"
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Redirect HTTP -> HTTPS when DEBUG=False (set to 0 if your proxy already does)
# DJANGO_SECURE_SSL_REDIRECT=1

# HSTS: only enable once HTTPS is confirmed working end-to-end (seconds; 0 = off).
# A premature value can lock browsers out of a still-HTTP domain for its duration.
# DJANGO_SECURE_HSTS_SECONDS=31536000


# ------------------------------------------------------------------------------
# CORS / CSRF
# ------------------------------------------------------------------------------
# Comma-separated, scheme included. When CORS_ALLOWED_ORIGINS is empty, all
# origins are allowed (development behaviour). ALWAYS set it in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------------------------
# AUTHENTICATION (SimpleJWT)
# ------------------------------------------------------------------------------
# Optional. Falls back to DJANGO_SECRET_KEY when unset.
# Django issues and validates all tokens - Supabase Auth is NOT used.
JWT_SECRET=


# ------------------------------------------------------------------------------
# EMAIL - Resend (signup OTP, password reset - via core/email_service.py)
# ------------------------------------------------------------------------------
# Architecture:  Django API -> core.email_service -> Resend
# The frontend never talks to Resend directly and never sees these values.
#
# Leave both EMAIL_HOST and RESEND_API_KEY empty (the default) for local dev -
# Django prints emails to the console instead of sending them, so the OTP
# flow is fully testable with zero external credentials.
#
#   1. Sign up for Resend (free tier) at https://resend.com
#   2. Dashboard -> API Keys -> create a key
#
# Two ways to actually send mail with that key - RESEND_API_KEY is the one to
# prefer, especially on a host (Render, Railway, etc.) that throttles or
# blocks outbound SMTP: it uses Resend's plain-HTTPS API instead of raw SMTP,
# so a blocked/slow SMTP port can't hang the whole signup/OTP request:
#
# RESEND_API_KEY=
#
# The older path, kept for hosts where outbound SMTP is known to work fine -
# do not set both; RESEND_API_KEY takes priority when present:
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
#
# DEFAULT_FROM_EMAIL: use onboarding@resend.dev until a real domain is
# purchased and verified in Resend - do NOT invent a custom-domain address
# before then, Resend will reject it.
# DEFAULT_FROM_EMAIL=onboarding@resend.dev
RESEND_API_KEY=
EMAIL_HOST=


# ------------------------------------------------------------------------------
# MEDIA STORAGE - Google Drive (OAuth user-authorized, personal account)
# ------------------------------------------------------------------------------
# Files (teacher avatars, course thumbnails, study-material PDFs, student
# uploads, subjective answer files) go to a Google Drive account via Django's
# storage abstraction. Binary media is NEVER stored inside PostgreSQL.
#
# This is NOT a Google Service Account - service accounts have their own,
# effectively empty storage quota. It's OAuth user authorization against a
# real personal/Workspace Drive account (free tier: 15GB).
#
# One-time setup (run locally by whoever owns the Drive account):
#   1. Google Cloud Console -> new/existing project -> enable "Google Drive API"
#   2. APIs & Services -> OAuth consent screen -> External -> add yourself as
#      a Test user (required while the app is unpublished)
#   3. Credentials -> Create OAuth client ID -> Application type: Desktop app
#      -> copy the Client ID and Client Secret below
#   4. python manage.py drive_authorize
#      Follow the printed URL, log in, click Allow, then copy the printed
#      refresh token into GOOGLE_DRIVE_REFRESH_TOKEN below.
#   5. GOOGLE_DRIVE_ROOT_FOLDER_ID is filled in automatically the first time
#      the app runs (it creates a "LoksewaAI" folder in the Drive account and
#      you should copy its ID here so it isn't re-searched on every boot).
#
# Leave these empty in development to use local disk (apps/api/media/).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Optional Unicode TrueType font for generated question papers. Set this to a
# font file that supports Devanagari (for example Nirmala.ttc on Windows).
# SUBJECTIVE_EXAM_PDF_FONT_PATH=


# ------------------------------------------------------------------------------
# AI TUTOR (optional)
# ------------------------------------------------------------------------------
# Used by ai_tutor/services.py. Without it, the AI Tutor runs in mock mode.
# GEMINI_API_KEY=

# Used by analytics/services/ai_service.py (a separate, OpenAI-compatible
# analytics AI call, distinct from the Gemini-based AI Tutor above).
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini


# ------------------------------------------------------------------------------
# CACHE / CELERY BROKER
# ------------------------------------------------------------------------------
# Used as the Celery broker + result backend (backend/celery.py) for the
# background jobs in core/tasks.py, exams/tasks.py, and
# administration/tasks.py - scheduled notification dispatch, exam
# auto-archiving, and background CSV exports. CELERY_BROKER_URL is accepted
# as an alternate name if you'd rather keep this one cache-only later.
# Without it, `manage.py` commands still work (Celery isn't imported until
# something actually calls a task), but `celery -A backend worker`/`beat`
# have nothing to connect to.
# REDIS_URL=


# ------------------------------------------------------------------------------
# ERROR MONITORING (Sentry)
# ------------------------------------------------------------------------------
# Unset (the default) means sentry_sdk.init() is never called - no network
# calls, no behavior change. Set SENTRY_DSN from your Sentry project's
# Settings > Client Keys (DSN) page to start reporting unhandled exceptions.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1


# ------------------------------------------------------------------------------
# BOOTSTRAP ADMIN (optional - used only by `manage.py create_default_admin`)
# ------------------------------------------------------------------------------
# If unset, the command falls back to a well-known default password. Always
# set these explicitly before running the command against production.
# DEFAULT_ADMIN_EMAIL=admin@loksewa.ai
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=


# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# NEVER expose to the browser / Next.js / NEXT_PUBLIC_* / GitHub:
#   - DATABASE_URL, DIRECT_URL, the Supabase database password
#   - the Supabase service_role key
#   - DJANGO_SECRET_KEY, JWT_SECRET
#   - S3_ACCESS_KEY, S3_SECRET_KEY (if still used)
#   - GOOGLE_DRIVE_CLIENT_SECRET, GOOGLE_DRIVE_REFRESH_TOKEN
#   - any payment or AI provider key
#
# The Next.js app needs exactly one variable: NEXT_PUBLIC_API_URL, pointing at
# this Django API. It holds no database or Supabase credentials.
# ==============================================================================
